{
  "name": "Framed",
  "version": "Forked - 1.0.26",
  "slug": "framed",
  "description": "Fork of An e-paper calendar, weather, and smart home family dashboard by Joel Hawksley",
  "url": "https://github.com/joelhawksley/timeframe",
  "arch": ["aarch64", "amd64"],
  "homeassistant_api": true,
  "hassio_role": "default",
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:calendar-clock",
  "panel_title": "Framed",
  "host_network": true,
  "map": ["data:rw"],
  "ports": {
    "8099/tcp": 8099,
    "11114/tcp": 11114
  },
  "ports_description": {
    "8099/tcp": "Web interface",
    "11114/tcp": "Visionect device protocol"
  },
  "options": {
    "speed_unit": "mph",
    "precipitation_unit": "in",
    "temperature_unit": "F"
  },
  "schema": {
    "speed_unit": "list(mph|kph)",
    "precipitation_unit": "list(in|mm)",
    "temperature_unit": "list(F|C)"
  }
}
